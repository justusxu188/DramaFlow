# ==========================================================================
# DramaFlow · Real-Mode Environment File
# Location on servers: /etc/frameflow.env
# Loaded by systemd EnvironmentFile= (frameflow.service), NOT by dotenv in code.
# --------------------------------------------------------------------------
# EVERY KEY MARKED "[REQUIRED]" MUST BE FILLED before starting frameflow.service.
# Application startup will THROW if required real-mode credentials are missing.
#
# Value quoting rules:
#   · Do NOT quote values unless they contain leading/trailing whitespace or a
#     literal hash '#'. Quotes become part of the value when you use them.
#   · Do NOT export prefix: each line is KEY=VALUE only.
#   · Comments start with '#' at the beginning of a line.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. Runtime switches
# --------------------------------------------------------------------------
# [REQUIRED] Provider mode. Keep 'real' here — this file is the real-mode only
# template. Mock deployments do NOT need this file; they can live with the
# built-in defaults (PROVIDER_MODE=mock).
PROVIDER_MODE=real

# Persistence. Use "local" (JSON store under data/) OR "mysql" (Prisma + DATABASE_URL).
# "local" is the default DramaFlow deployment shape — no MySQL required.
PERSISTENCE_MODE=local

# Only needed when PERSISTENCE_MODE=mysql. For local mode you can keep the placeholder.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/AIGCAdv

# [REQUIRED] HMAC secret for signed login sessions. Generate once with:
#   openssl rand -hex 32
# Keep the value stable across restarts. Changing it logs out all users.
FRAMEFLOW_AUTH_SECRET=

# --------------------------------------------------------------------------
# 2. Volcano Engine Ark (方舟) — LLM + Image + Video models [REQUIRED set]
# --------------------------------------------------------------------------
# Console: https://console.volcengine.com/ark/
#
# [REQUIRED] API Key created under "App Access → API Key Management". Length ~36.
ARK_API_KEY=
# Default base URL for Ark chat/completions. Usually you do NOT change this.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Doubao-seed text endpoints — create an Endpoint (接入点) per model and paste
# the ep-xxxxxxxxxxxxxxx id here (len ~23).
# [REQUIRED] At minimum SEED_2_1_PRO must be SET.
ARK_TEXT_MODEL_SEED_2_1_PRO=
ARK_TEXT_MODEL_SEED_2_0_LITE=

# Seedream image endpoints (至少填一个 LITE 或 PRO；或两者都填)
# [REQUIRED] pick AT LEAST one of ARK_IMAGE_MODEL_SEEDREAM_5_0_LITE / PRO.
ARK_IMAGE_MODEL_SEEDREAM_5_0_LITE=
ARK_IMAGE_MODEL_SEEDREAM_5_0_PRO=
ARK_IMAGE_MODEL=

# Seedance video endpoints (至少填一个)
# [REQUIRED] pick AT LEAST one of the four below.
ARK_VIDEO_MODEL_SEEDANCE_2_5=
ARK_VIDEO_MODEL_SEEDANCE_2_0=
ARK_VIDEO_MODEL_SEEDANCE_2_0_FAST=
ARK_VIDEO_MODEL_SEEDANCE_2_0_MINI=
ARK_VIDEO_MODEL=

# Per-video cap in seconds. Seedance free tiers typically cap at 15s.
ARK_VIDEO_MAX_DURATION=15

# --------------------------------------------------------------------------
# 3. Ark Assets IAM — uploading character images / prompts to Ark buckets
# --------------------------------------------------------------------------
# Console: https://console.volcengine.com/iam/  (create an IAM sub-user + AK/SK)
# Attach Ark built-in policy or the minimal ark:PutObject / ark:GetObject actions
# on the resources your app uses.
#
# [STRONGLY RECOMMENDED; real tasks will fail uploads if empty]
ARK_ASSETS_ACCESS_KEY_ID=
ARK_ASSETS_SECRET_ACCESS_KEY=
ARK_ASSETS_PROJECT_NAME=default
ARK_ASSETS_BASE_URL=https://ark.cn-beijing.volcengineapi.com

# --------------------------------------------------------------------------
# 4. Volcano Engine MediaKit — video split / subtitles / shot segmentation
# --------------------------------------------------------------------------
# Console: https://console.volcengine.com/mediakit/
# [REQUIRED] create an API Key, paste here (length ~47).
MEDIAKIT_API_KEY=
MEDIAKIT_BASE_URL=https://mediakit.cn-beijing.volces.com/api/v1

# --------------------------------------------------------------------------
# 5. Volcano Engine TOS — object storage for user uploads + pipeline artifacts
# --------------------------------------------------------------------------
# Console: https://console.volcengine.com/tos/
# Create a bucket (建议 cn-beijing, same region as Ark/MediaKit), then:
#   - paste the bucket name below
#   - paste the region
#   - paste the public Endpoint host from the bucket overview page
#   - use a pair of IAM AK/SK with TOS read/write on that bucket (可与 #3 共享)
#
# [STRONGLY RECOMMENDED; real tasks cannot upload files without TOS configured]
TOS_REGION=cn-beijing
TOS_ENDPOINT=
TOS_BUCKET=
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=

# --------------------------------------------------------------------------
# 6. Volcano Engine VOD Watermark — optional post-production watermark chain
# --------------------------------------------------------------------------
# Skip this whole section if you don't need platform watermarks.
# Console: https://console.volcengine.com/vod/
#
# 6.1 common
VOLCENGINE_VOD_ACCESS_KEY_ID=
VOLCENGINE_VOD_SECRET_ACCESS_KEY=
VOD_REGION=cn-north-1
VOD_SPACE_NAME=
VOD_BUCKET_NAME=
VOD_PLAY_DOMAIN=
# 6.2 at least one template together with 6.1 is required for watermark support
VOD_WATERMARK_WORKFLOW_ID=
# (pick one or more of the three template ids below)
VOD_WATERMARK_TEMPLATE_ID=
VOD_IMAGE_WATERMARK_TEMPLATE_ID=
VOD_TEXT_WATERMARK_TEMPLATE_ID=
VOD_TEXT_WATERMARK_VARIABLE_KEY=input_text
